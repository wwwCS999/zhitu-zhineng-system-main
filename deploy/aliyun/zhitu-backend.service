[Unit]
Description=Zhitu Intelligent Matching Backend
After=network.target

[Service]
Type=simple
User=zhitu
Group=zhitu
WorkingDirectory=/opt/zhitu-system
EnvironmentFile=/opt/zhitu-system/.env
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -Djava.net.preferIPv4Stack=true -Djava.net.useSystemProxies=true -jar /opt/zhitu-system/backend/target/zhitu-backend-1.0.0.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
