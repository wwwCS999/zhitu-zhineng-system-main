# Copy this file to /opt/zhitu-system/.env on the server and fill secrets there.
# Do not commit real API keys or database passwords.

AI_ENABLED=true

# Smart Q&A: Qwen on Alibaba Cloud Bailian / DashScope compatible endpoint.
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_FALLBACK_MODEL=qwen-turbo
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Optional. If left unset, the application falls back to DASHSCOPE_API_KEY.
# AI_API_KEY=

# Resume parsing and learning planning: DeepSeek text model.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
AI_RESUME_MODEL=deepseek-chat
AI_LEARNING_MODEL=deepseek-chat
AI_RESUME_EXTERNAL_PARSER_MODEL=deepseek-chat
AI_RESUME_EXTERNAL_PARSER_BASE_URL=https://api.deepseek.com/v1
# Fill the same value as DEEPSEEK_API_KEY when the external parser is enabled.
AI_RESUME_EXTERNAL_PARSER_API_KEY=

# Image resume understanding: Qwen-VL on Bailian / DashScope.
AI_RESUME_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Fill the same value as DASHSCOPE_API_KEY for Qwen-VL image resume parsing.
AI_RESUME_VISION_API_KEY=your_qwen_vl_api_key_here
AI_RESUME_VISION_MODEL=qwen-vl-plus

AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=180000
AI_MAX_TOKENS=4096
AI_RESUME_MAX_TOKENS=3200
AI_RESUME_TEXT_MAX_CHARS=18000
AI_RETRIEVAL_RECENT_RAW_ROWS=20000
AI_MAX_CONTEXT_CHARS=10000

# Existing million-JD MySQL source. Prefer Alibaba Cloud RDS or private VPC MySQL.
RAW_DB_URL=jdbc:mysql://127.0.0.1:3306/career_data_governance?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&connectTimeout=10000&socketTimeout=600000&tcpKeepAlive=true&rewriteBatchedStatements=true
RAW_DB_USERNAME=root
RAW_DB_PASSWORD=
RAW_DB_TABLE=dataset_job_raw
RAW_HOLDOUT_YEAR=2026
RAW_HOLDOUT_SIZE=1000
RAW_HOLDOUT_SEED=zhitu-2026-v1

# CORS origins. Replace with your real domain after DNS is ready.
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP,https://YOUR_DOMAIN

