# ===== AI question answering / resume parsing: DeepSeek OpenAI-compatible mode =====
# Keep the key on the backend only. Do not put it in frontend code.
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your_ai_api_key_here
# Also supported if you prefer provider-specific names:
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
ALI_API_KEY=
AI_MODEL=deepseek-chat
AI_FALLBACK_MODEL=
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=180000
AI_MAX_TOKENS=4096
AI_RESUME_ENABLED=true
AI_RESUME_MODEL=deepseek-chat
# DeepSeek official hosted API is text-only at the moment. For image resumes,
# point these three variables to an OpenAI-compatible vision OCR endpoint
# such as a local DeepSeek-VL2/Qwen-VL service.
AI_RESUME_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_RESUME_VISION_API_KEY=your_qwen_vl_api_key_here
AI_RESUME_VISION_MODEL=qwen-vl-max
AI_RESUME_MAX_TOKENS=3200
AI_RESUME_TEXT_MAX_CHARS=18000
AI_RETRIEVAL_RECENT_RAW_ROWS=20000
AI_MAX_CONTEXT_CHARS=10000

# ===== MySQL / Docker defaults =====
MYSQL_DATABASE=zhitu
MYSQL_USER=zhitu
MYSQL_PASSWORD=zhitu123
MYSQL_ROOT_PASSWORD=root123

# ===== Existing million-JD MySQL source =====
RAW_DB_URL=jdbc:mysql://localhost:3306/career_data_governance?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
RAW_DB_USERNAME=root
RAW_DB_PASSWORD=123456
RAW_DB_TABLE=dataset_job_raw
RAW_HOLDOUT_YEAR=2026
RAW_HOLDOUT_SIZE=1000
RAW_HOLDOUT_SEED=zhitu-2026-v1
